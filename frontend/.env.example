# Restrict access to institute mail (defaults: nia.edu.in, nia.edu.ac.in)
# VITE_ALLOWED_EMAIL_DOMAINS=nia.edu.in,nia.edu.ac.in
# Legacy single domain if you do not use DOMAINS:
# VITE_ALLOWED_EMAIL_DOMAIN=nia.edu.in
# Optional: comma-separated list — if set, only these full addresses may sign up / sign in
# VITE_ALLOWED_EMAIL_ALLOWLIST=alice@nia.edu.in,bob@nia.edu.in
# Firebase email verification: must use a URL whose domain is in Firebase → Auth → Authorized domains
# VITE_EMAIL_VERIFICATION_CONTINUE_URL=https://nia-ot-manager.vercel.app/login?verified=1
